# Copy the Admin values to apps/admin/.env.local.
# Public values are safe to expose to browser clients when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Copy these values to apps/pos/.env.local for the online POS.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Never place SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY in a
# NEXT_PUBLIC_ or VITE_ variable.
# Server-only secrets belong in a secure deployment environment, not this file.
