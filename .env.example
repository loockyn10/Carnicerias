# Public Supabase values. Safe to expose to browser clients when RLS is enabled.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Never place SUPABASE_SERVICE_ROLE_KEY in a NEXT_PUBLIC_ or VITE_ variable.
# Server-only secrets belong in a secure deployment environment, not this file.

